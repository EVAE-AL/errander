# Copy this file to .env and fill in your key. Any OpenAI-compatible provider works.
# Never commit your real .env.

# --- DeepSeek ---------------------------------------------------------------
ERRANDER_BASE_URL=https://api.deepseek.com
ERRANDER_MODEL=deepseek-chat
ERRANDER_API_KEY=sk-your-key-here

